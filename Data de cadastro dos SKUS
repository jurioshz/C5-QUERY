select X.SEQPRODUTO, X.DESCCOMPLETA, X.SEQFAMILIA,
to_char(X.DTAHORINCLUSAO, 'DD/MM/YYYY HH24:MI') DTA_CADASTRO, X.USUARIOINCLUSAO USUARIO_CADASTRO,
to_char(Y.DTAULTENTRADA, 'DD/MM/YYYY') DTAULTENTRADA, to_char(Y.DTAULTVENDA, 'DD/MM/YYYY') DTAULTVENDA,
case
  when Y.DTAULTENTRADA is null and Y.DTAULTVENDA is null then 'SEM MOVIMENTO'
    else 'COM MOVIMENTO'
      end STATUS_SKU
from MAP_PRODUTO X,
(select Z.SEQPRODUTO, max(Z.DTAULTENTRADA) DTAULTENTRADA, max(Z.DTAULTVENDA) DTAULTVENDA
from MRL_PRODUTOEMPRESA Z
group by Z.SEQPRODUTO) Y
where Y.SEQPRODUTO(+) = X.SEQPRODUTO
and trunc(X.DTAHORINCLUSAO) between :DT1 and :DT2
order by X.DTAHORINCLUSAO desc
