select W.TIPO, W.NROEMPRESA, W.NUMERONF, W.SERIE, W.MODELO, W.CGO||' - '||(select Z.DESCRICAO from consinco.max_codgeraloper Z where Z.CODGERALOPER = W.CGO) OPERACAO, W.CFOP, W.DTAENTRADA, W.NOMERAZAO, W.CCLASSTRIB,
W.VBCIBSCBS, W.PIBSUF, W.PREDALIQIBSUF, W.PALIQEFETIBSUF, W.VIBSUF, W.PIBSMUN, W.PREDALIQIBSMUN, W.PALIQEFETIBSMUN, W.VIBSMUN, W.VIBSUF + W.VIBSMUN VIBS, W.PCBS,
W.PREDALIQCBS, W.PALIQEFETCBS, W.VCBS,
to_char(:DT1,'DD/MM/YYYY') INICIO,
to_char(:DT2,'DD/MM/YYYY') FIM,
nvl(:LS1,'TODOS') EMPRESA,
nvl(:LS2,'TODOS') CODGERAL,
nvl(:LS3,'TODOS') TIPO_FILTRO
from (select decode(Y.TIPNOTAFISCAL,'E','ENTRADA','SAIDA') TIPO, Y.NROEMPRESA, Y.NUMERONF, Y.SERIENF SERIE, Y.MODELONF MODELO, Y.CODGERALOPER CGO,
YI.CFOP, to_char(nvl(Y.DTAENTRADA,Y.DTAEMISSAO),'DD/MM/YYYY') DTAENTRADA, Y.SEQPESSOA||' - '||YII.NOMERAZAO NOMERAZAO,
lpad(nvl(YI.CCLASSTRIBCBS,YI.CCLASSTRIBIBSUF),6,'0') CCLASSTRIB,
sum(nvl(YI.VLRBASECBS,0)) VBCIBSCBS,
max(nvl(YI.PERALIQIBSUF,0)) PIBSUF,
max(nvl(YI.PERALIQREDIBSUF,0)) PREDALIQIBSUF,
max(nvl(YI.PERALIQEFETIVAIBSUF,0)) PALIQEFETIBSUF,
sum(nvl(YI.VLRIMPOSTOIBSUF,0)) VIBSUF,
max(nvl(YI.PERALIQIBSMUN,0)) PIBSMUN,
max(nvl(YI.PERALIQREDIBSMUN,0)) PREDALIQIBSMUN,
max(nvl(YI.PERALIQEFETIVAIBSMUN,0)) PALIQEFETIBSMUN,
sum(nvl(YI.VLRIMPOSTOIBSMUN,0)) VIBSMUN,
max(nvl(YI.PERALIQCBS,0)) PCBS,
max(nvl(YI.PERALIQREDCBS,0)) PREDALIQCBS,
max(nvl(YI.PERALIQEFETIVACBS,0)) PALIQEFETCBS,
sum(nvl(YI.VLRIMPOSTOCBS,0)) VCBS
from consinco.mlf_notafiscal Y
inner join consinco.mlf_nfitem YI on (YI.SEQNF = Y.SEQNF)
inner join consinco.ge_pessoa YII on (YII.SEQPESSOA = Y.SEQPESSOA)
inner join consinco.ge_empresa YIII on (YIII.NROEMPRESA = Y.NROEMPRESA)
where YIII.NOMEREDUZIDO in (#LS1)
and Y.CODGERALOPER in (#LS2)
and Y.CODGERALOPER != 5
and Y.STATUSNF != 'C'
and (Y.TIPNOTAFISCAL = 'E' or nvl(Y.STATUSNFE,4) = 4)
and greatest(Y.DTAEMISSAO,nvl(Y.DTAENTRADA,Y.DTAEMISSAO)) between :DT1 and :DT2
group by Y.TIPNOTAFISCAL,
Y.SEQNF, Y.NROEMPRESA, Y.NUMERONF, Y.SERIENF, Y.MODELONF, Y.CODGERALOPER, YI.CFOP, nvl(Y.DTAENTRADA,Y.DTAEMISSAO), Y.SEQPESSOA, YII.NOMERAZAO,
lpad(nvl(YI.CCLASSTRIBCBS,YI.CCLASSTRIBIBSUF),6,'0')
union all
select case when Z.MODELODF = '65' then 'NFC-E' when ZIV.ENTRADASAIDA = 'E' then 'ENTRADA' else 'SAIDA' end TIPO,
Z.NROEMPRESA, Z.NUMERODF, Z.SERIEDF, Z.MODELODF, Z.CODGERALOPER, ZI.CFOP,
to_char(Z.DTAMOVIMENTO,'DD/MM/YYYY'), Z.SEQPESSOA||' - '||ZII.NOMERAZAO,
lpad(nvl(ZI.CCLASSTRIBCBS,ZI.CCLASSTRIBIBSUF),6,'0'),
sum(nvl(ZI.VLRBASECBS,0)),
max(nvl(ZI.PERALIQIBSUF,0)),
max(nvl(ZI.PERALIQREDIBSUF,0)),
max(nvl(ZI.PERALIQEFETIVAIBSUF,0)),
sum(nvl(ZI.VLRIMPOSTOIBSUF,0)),
max(nvl(ZI.PERALIQIBSMUN,0)),
max(nvl(ZI.PERALIQREDIBSMUN,0)),
max(nvl(ZI.PERALIQEFETIVAIBSMUN,0)),
sum(nvl(ZI.VLRIMPOSTOIBSMUN,0)),
max(nvl(ZI.PERALIQCBS,0)),
max(nvl(ZI.PERALIQREDCBS,0)),
max(nvl(ZI.PERALIQEFETIVACBS,0)),
sum(nvl(ZI.VLRIMPOSTOCBS,0))
from consinco.mfl_doctofiscal Z
inner join consinco.mfl_dfitem ZI on (ZI.SEQNF = Z.SEQNF)
inner join consinco.ge_pessoa ZII on (ZII.SEQPESSOA = Z.SEQPESSOA)
inner join consinco.ge_empresa ZIII on (ZIII.NROEMPRESA = Z.NROEMPRESA)
inner join consinco.ge_cgo ZIV on (ZIV.CGO = Z.CODGERALOPER)
where ZIII.NOMEREDUZIDO in (#LS1)
and Z.CODGERALOPER in (#LS2)
and Z.CODGERALOPER != 5
and Z.STATUSDF != 'C'
and nvl(ZI.STATUSITEM,'V') != 'C'
and nvl(Z.STATUSNFE,4) = 4
and Z.DTAMOVIMENTO between :DT1 and :DT2
group by Z.MODELODF,
ZIV.ENTRADASAIDA, Z.SEQNF, Z.NROEMPRESA, Z.NUMERODF, Z.SERIEDF, Z.CODGERALOPER, ZI.CFOP, Z.DTAMOVIMENTO, Z.SEQPESSOA, ZII.NOMERAZAO,
lpad(nvl(ZI.CCLASSTRIBCBS,ZI.CCLASSTRIBIBSUF),6,'0')) W
where W.TIPO in (#LS3)
order by 1,2,3,7,10
